# Created by AuToFF

SPCFW {

  write("Data Atoms") {
    $atom:O01      $mol:SPCE     @atom:OW              0     0.986700    -0.078700    -0.069600
    $atom:H02      $mol:SPCE     @atom:HW              0     1.954600    -0.037900    -0.091700
    $atom:H03      $mol:SPCE     @atom:HW              0     0.707900     0.737400    -0.511200
  }

  write_once("Data Masses") {
    @atom:OW                15.9994
    @atom:HW                 1.0080
  }

  write("Data Bonds") {
    $bond:1      @bond:B1      $atom:O01      $atom:H02     
    $bond:2      @bond:B1      $atom:O01      $atom:H03     
  }

  write("Data Angles") {
    $angle:1      @angle:A1      $atom:H02      $atom:O01      $atom:H03     
  }

  write_once("In Settings") {
    # -- Non-bonded interactions --
    pair_coeff      @atom:OW           @atom:OW             0.006739   3.165570
    pair_coeff      @atom:HW           @atom:OW             0.000000   1.582785
    pair_coeff      @atom:HW           @atom:HW             0.000000   0.000000

    # -- harmonic bondType parameter  --
    bond_coeff      @bond:B1               17.8784    1.01200

    # -- harmonic angleType parameter  --
    angle_coeff     @angle:A1              1.9848     113.240000

  }

  write_once("In Init") {
    units           metal
    boundary        p p p
    atom_style      full
    pair_style      lj/cut/coul/long 10.0
    pair_modify     mix arithmetic
    special_bonds   lj/coul 0.0 0.0 1
    kspace_style    pppm/tip4p 1.0e-4
    bond_style      harmonic
    angle_style     harmonic
  }
}
